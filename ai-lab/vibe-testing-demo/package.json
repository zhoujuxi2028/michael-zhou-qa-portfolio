{
  "name": "vibe-testing-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "test": "playwright test tests/generated/v1 --project=chromium",
    "test:smoke": "playwright test tests/smoke --project=chromium",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:coverage": "c8 --all --include=scripts/check-assertions.mjs --include=scripts/serve.mjs --include=scripts/check-mutant.mjs --check-coverage --lines=80 --statements=80 --branches=70 --functions=75 node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "lint": "eslint scripts tests --ext .mjs",
    "typecheck": "tsc --noEmit",
    "test:mutant": "node scripts/check-mutant.mjs"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.86",
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.11",
    "c8": "9.1.0",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "typescript": "5.9.3"
  }
}

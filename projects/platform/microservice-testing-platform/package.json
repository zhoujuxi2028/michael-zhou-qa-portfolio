{
  "name": "microservice-testing-platform",
  "version": "1.0.0",
  "description": "E-commerce microservice testing platform - Order, Inventory, Payment",
  "private": true,
  "scripts": {
    "lint": "eslint services/ tests/ shared/",
    "lint:fix": "eslint services/ tests/ shared/ --fix",
    "format": "prettier --write 'services/**/*.js' 'tests/**/*.js' 'shared/**/*.js'",
    "format:check": "prettier --check 'services/**/*.js' 'tests/**/*.js' 'shared/**/*.js'",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:contract": "jest --testPathPatterns=tests/contract",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:e2e": "jest --testPathPatterns=tests/e2e",
    "test:observability": "jest --testPathPatterns=tests/observability",
    "test:all": "jest --testPathPatterns='tests/(unit|contract|integration|e2e|observability)'",
    "test:coverage": "jest --testPathPatterns='tests/(unit|contract|integration|e2e|observability)' --coverage",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:test": "docker compose up -d && npm run test:e2e && docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-html-reporters": "^3.1.7",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.0",
    "uuid": "^8.3.2",
    "winston": "^3.11.0"
  }
}
